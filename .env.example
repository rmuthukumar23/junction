# Copy to .env (git-ignored) and fill in. scripts/judge.sh reads it; shell variables win.
# Never commit .env or paste its contents into chats, issues or command arguments.

# Gemini (Google AI Studio). envkit eval forwards it to OpenCode as
# GOOGLE_GENERATIVE_AI_API_KEY for google/... and gemini/... models.
GEMINI_API_KEY=

# The model to play, as OpenCode names it, e.g. google/gemini-4-hydrogen.
# scripts/judge.sh passes it as --model unless you give --model yourself.
AFTERQUERY_MODEL=

# Other providers, if used: name the variable with --credential-env.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
