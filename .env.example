# Copy this file to `.env` (ignored by git) and fill in the values.
# scripts/judge.sh loads `.env` automatically; values never appear on a command line.
#
#   cp .env.example .env

# Google AI Studio key for Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Model id as OpenCode names it, e.g. google/gemini-2.5-pro
AFTERQUERY_MODEL=
