# Copy to .env (git-ignored) and fill in. scripts/judge.sh reads it; shell variables win.
# Never commit .env or paste its contents into chats, issues or command arguments.

# One key per provider you want to run. envkit eval picks the key from the model's
# provider prefix and forwards it to OpenCode inside Harbor (never on the command line):
#   google/... or gemini/...  -> GEMINI_API_KEY (forwarded as GOOGLE_GENERATIVE_AI_API_KEY)
#   anthropic/...             -> ANTHROPIC_API_KEY
#   openai/...                -> OPENAI_API_KEY
# Leave a provider's line empty if you don't use it. --credential-env NAME overrides.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# The model to play, as OpenCode names it (gemini-4-hydrogen ran this harness successfully).
# scripts/judge.sh passes it as --model unless you give --model yourself; for a comparison,
# pass --model per run instead (see docs/GREENHOUSE_SPEC.md section 12).
AFTERQUERY_MODEL=google/gemini-4-hydrogen

# Modal (development backend only, --backend modal): run `modal setup` once, which writes
# ~/.modal.toml, or set both of these. A single "API token" variable is not read.
MODAL_API_TOKEN=
# Fine-tuning stretch goal (docs/FINETUNE.md). FT_BASE_URL is the vLLM server that
# `modal deploy scripts/finetune/modal_serve.py` prints, plus /v1. VLLM_API_KEY is any random
# string; store the same value in the Modal secret `greenhouse-vllm`.
FT_BASE_URL=
VLLM_API_KEY=
